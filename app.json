{
  "expo": {
    "name": "CryptoTracker",
    "slug": "crypto-tracker",
    "scheme": "cryptotracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon2.png",
    "userInterfaceStyle": "automatic",

    "description": "Track live cryptocurrency prices, market trends, and alerts in real time.",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.narmatha.cryptotracker",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow CryptoTracker to use the microphone for voice features.",
        "NSSpeechRecognitionUsageDescription": "Allow CryptoTracker to use speech recognition for voice search."
      }
    },

    "android": {
      "package": "com.narmatha.cryptotracker",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon2.png",
        "backgroundColor": "#00000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },

    "web": {
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon2.png",
          "color": "#3b82f6"
        }
      ],
      "expo-speech-recognition",
      "expo-web-browser",
      "expo-secure-store"
    ],

    "extra": {
      "router": {},
      "eas": {
        "projectId": "8e96bca0-0470-406d-b534-d73eb946ed8a"
      }
    },

    "owner": "narmatha_thangarasu"
  }
}
